{
  "name": "ssakssak-video-compressor",
  "version": "1.0.0",
  "description": "싹싹김치 비디오 압축기 — 카톡/디스코드 용량 맞춤 압축, 100% 로컬",
  "author": "싹싹김치",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ssakkimchi.compressor",
    "productName": "싹싹김치 비디오 압축기",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "extraFiles": [
      "LICENSE",
      "THIRD_PARTY_LICENSES.md"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SsakSsak-Compressor-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "gyqls051-arch",
      "repo": "ssakssak-compressor"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
